# ── Production (required on Vercel / any host) ────────────────────────────
# Postgres connection string. Free tier: https://neon.com (no credit card).
# When set, the app uses this DB; when unset, it falls back to an embedded
# in-memory Postgres (dev only — data resets on restart).
DATABASE_URL=

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Your public app URL, e.g. https://tesla-innovation.vercel.app
# (or your custom domain). Used by Better Auth for cookies/OAuth origins.
BETTER_AUTH_URL=

# Admin account seeded at startup (email below gets the admin role) and its
# sign-in password. Omit STUDIO_ADMIN_PASSWORD to skip admin seeding.
STUDIO_ADMIN_EMAIL=cmcvayhomes@gmail.com
STUDIO_ADMIN_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────
# Set to "false" ONLY for throwaway local demos (runs as a shared dev user,
# no real sign-in). Never set it on a host with a real DATABASE_URL.
VITE_AUTH_ENABLED=
